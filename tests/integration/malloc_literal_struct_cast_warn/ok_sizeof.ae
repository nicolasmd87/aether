// Should be SILENT: sizeof(T) is layout-exact and immune to any struct-layout
// change — the blessed idiom the warning nudges toward.
import std.io

extern malloc(n: int) -> ptr

struct Node {
    name: string
    next: ptr
}

main() {
    n = malloc(sizeof(Node)) as *Node
    n.name = "x"
    println("built")
}
